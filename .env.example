# Telegram
BOT_TOKEN=

# Owner (pisahkan dengan koma)
OWNER_IDS=123456789

# Command
BOT_PREFIX=/
TZ=Asia/Jakarta

# Database: json (default) | sqlite — file di folder DB_DIR
# Disarankan 'sqlite' untuk data user/economy yang lebih aman & cepat.
DB_TYPE=sqlite
DB_DIR=data

# Tampilan menu (bisa diubah owner dari bot: /menu -> Settings)
MENU_PHOTO=https://img1.pixhost.to/images/9569/653523193_image.jpg
MENU_TITLE=Telebot
MENU_SUBTITLE=Modular Telegram bot — Telegraf
MENU_REPO_URL=https://github.com/slowlyh/Telebot
MENU_SITE_URL=https://hyuu.tech
MENU_STYLE=photo

# Ekonomi (bisa diubah owner via /seteco)
ECO_REGISTER_BONUS=5000
ECO_REGISTER_LIMIT=25
ECO_DAILY_BONUS=1500
ECO_CAPTCHA_LENGTH=5
ECO_CAPTCHA_TTL_MS=300000
ECO_CURRENCY=💰

# RPG dasar
RPG_JOIN_COST=500
RPG_ADVENTURE_COST=1
RPG_ADVENTURE_EXP=25
